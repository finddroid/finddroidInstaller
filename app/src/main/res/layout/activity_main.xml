<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000"
    tools:context=".MainActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#000"
            android:elevation="1.5dp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FindDroid Installer"
                android:layout_marginLeft="20dp"
                android:layout_gravity="center"
                android:textSize="20sp"
                android:textColor="#666"
                />
        </LinearLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:background="#000"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                >

                <!-- App Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/appIcon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/findroid_dark_logo"
                        android:scaleType="centerCrop"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/appName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FindDroid"
                            android:textSize="18sp"
                            android:textColor="#666"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/developerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Main App"
                            android:textSize="14sp"
                            android:textColor="#666"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:text="20MB"
                            android:id="@+id/appSize"
                            android:textColor="#666"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Update Button -->
                <Button
                    android:id="@+id/updateBtn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Install"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#1DB954"
                    android:textColor="#fff"/>

                <ProgressBar
                    android:id="@+id/downloadProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:progressTint="#00FF88"
                    android:progressBackgroundTint="#333333"
                    android:max="100"
                    android:progress="0"
                    android:visibility="gone" />

                <!-- What's New -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Info"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginTop="20dp"/>

                <TextView
                    android:id="@+id/whatsNew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="This App is just a installer app for findroid \n \nclick on Install to Download FindDroid Main App \n\nThis App will be replaced by Main FindDroid App After installation"
                    android:textSize="14sp"
                    android:textColor="#444"
                    android:layout_marginTop="6dp"/>



                <!-- App Info -->
<!--                <TextView-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:text="App info"-->
<!--                    android:textStyle="bold"-->
<!--                    android:textSize="16sp"-->
<!--                    android:layout_marginTop="20dp"/>-->

<!--                <TextView-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:textSize="14sp"-->
<!--                    android:textColor="#444"-->
<!--                    android:layout_marginTop="6dp"/>-->

            </LinearLayout>
        </ScrollView>

    </LinearLayout>
</LinearLayout>